<%- include('../partials/app-open', { titulo: 'Representantes', ativo: 'reps' }) %>

<h2 class="title">Representantes</h2>
<p class="sub">Ganha um percentual sobre o valor dos pedidos em que for atribuído. A comissão padrão é ajustável por pedido.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="grid2">
  <div class="card pad">
    <div class="section-title">Novo representante</div>
    <form method="post" action="/admin/representantes">
      <div class="field"><label>Nome</label><input name="nome" placeholder="Carlos Souza" /></div>
      <div class="field"><label>Login</label><input name="login" placeholder="carlos.souza" /></div>
      <div class="field"><label>Senha</label><input name="senha" placeholder="definir senha" /></div>
      <div class="field"><label>Comissão padrão (%)</label><input name="comissao" placeholder="5" /></div>
      <button class="btn block" type="submit">Salvar representante</button>
    </form>
  </div>
  <div class="card pad">
    <div class="section-title">Representantes</div>
    <% if (reps.length === 0) { %><div class="empty">Nenhum representante ainda.</div><% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Login</th><th class="num">Comissão</th><th class="num">Pedidos</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% reps.forEach(function (r) { %>
          <tr>
            <td><%= r.nome %></td>
            <td class="dim"><%= r.login %></td>
            <td class="num"><span class="badge gold"><%= formatPercent(r.comissao_bps) %></span></td>
            <td class="num"><%= r.pedidos %></td>
            <td><% if (r.ativo) { %><span class="badge ok">Ativo</span><% } else { %><span class="badge neutral">Inativo</span><% } %></td>
            <td><form method="post" action="/admin/representantes/<%= r.id %>/toggle" style="margin:0"><button class="btn ghost sm" type="submit"><%= r.ativo ? 'Desativar' : 'Ativar' %></button></form></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<%- include('../partials/app-close') %>
