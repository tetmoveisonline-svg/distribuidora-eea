# Copie para .env (local) ou configure as variaveis no Railway.

# Porta (no Railway ela e injetada automaticamente).
PORT=3000

# Conexao com o Postgres. No Railway, use a variavel DATABASE_URL do plugin Postgres.
DATABASE_URL=postgres://usuario:senha@localhost:5432/central_postagem

# Segredo da sessao (troque por um valor aleatorio longo).
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-longo

# Ambiente (production no Railway).
NODE_ENV=development

# Credenciais do admin criadas pelo comando "npm run seed".
ADMIN_NOME=Administrador
ADMIN_LOGIN=admin
ADMIN_SENHA=admin123

# Dados da empresa que aparecem no cabecalho do comprovante (troque pelos reais).
EMPRESA_NOME=Sua Empresa / Nome
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_CONTATO=contato@suaempresa.com - (00) 00000-0000

# Textos configuraveis do comprovante.
COMPROVANTE_FORMA_PAGAMENTO=A combinar
COMPROVANTE_PRAZO_DESPACHO=Ate 1 dia util apos o aceite
