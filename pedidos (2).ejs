<%- include('../partials/app-open', { titulo: 'Pedidos recebidos', ativo: 'pedidos' }) %>

<h2 class="title">Pedidos recebidos</h2>
<p class="sub">Você (admin) vê tudo: valor, comissão do representante e taxa do funcionário. Clique num pedido para abrir o detalhe e atribuir a comissão.</p>

<div class="card pad">
  <% if (pedidos.length === 0) { %>
    <div class="empty">Nenhum pedido recebido ainda.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Pedido</th><th>Cliente</th><th class="num">Etiq.</th><th class="num">Valor</th>
          <th>Representante</th><th class="num">Comissão</th><th class="num">Taxa func.</th><th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach(function (p) { %>
          <tr>
            <td><a class="link-row" href="/admin/pedido/<%= p.id %>"><b><%= p.numero %></b></a></td>
            <td><%= p.cliente_nome %></td>
            <td class="num"><%= p.total_etiquetas %></td>
            <td class="num"><%= formatBRL(p.total_centavos) %></td>
            <td><%= p.rep_nome ? p.rep_nome : '—' %></td>
            <td class="num"><% if (p.comissao_centavos) { %><span class="badge gold"><%= formatBRL(p.comissao_centavos) %></span><% } else { %><span class="dim">—</span><% } %></td>
            <td class="num"><% if (p.taxa_func_centavos !== null) { %><span class="badge gold"><%= formatBRL(p.taxa_func_centavos) %></span><% } else { %><span class="dim">—</span><% } %></td>
            <td>
              <% if (p.status === 'despachado') { %><span class="badge ok">Despachado</span>
              <% } else if (p.status === 'preparando') { %><span class="badge info">Em preparação</span>
              <% } else { %><span class="badge warn">Aguardando</span><% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="hint-box">
  A coluna "Taxa func." aparece quando há um único funcionário ativo cadastrado
  <% if (!funcRef) { %>(no momento ela fica como — porque há zero ou mais de um funcionário; o valor de cada funcionário aparece na área dele).<% } %>
  Clique no número do pedido para atribuir o representante e a comissão, avançar o andamento e baixar os documentos.
</div>

<%- include('../partials/app-close') %>
