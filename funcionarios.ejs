<%- include('../partials/app-open', { titulo: 'Funcionários', ativo: 'funcs' }) %>

<h2 class="title">Funcionários</h2>
<p class="sub">Ganha um valor fixo por etiqueta e enxerga todos os pedidos.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="grid2">
  <div class="card pad">
    <div class="section-title">Novo funcionário</div>
    <form method="post" action="/admin/funcionarios">
      <div class="field"><label>Nome</label><input name="nome" placeholder="João Pereira" /></div>
      <div class="field"><label>Login</label><input name="login" placeholder="joao.pereira" /></div>
      <div class="field"><label>Senha</label><input name="senha" placeholder="definir senha" /></div>
      <div class="field"><label>Taxa por etiqueta (R$)</label><input name="taxa" placeholder="0,10" /></div>
      <button class="btn block" type="submit">Salvar funcionário</button>
    </form>
  </div>
  <div class="card pad">
    <div class="section-title">Funcionários</div>
    <% if (funcs.length === 0) { %><div class="empty">Nenhum funcionário ainda.</div><% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Login</th><th class="num">Taxa/etiqueta</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% funcs.forEach(function (f) { %>
          <tr>
            <td><%= f.nome %></td>
            <td class="dim"><%= f.login %></td>
            <td class="num"><span class="badge gold"><%= formatBRL(f.taxa_etiqueta_centavos) %></span></td>
            <td><% if (f.ativo) { %><span class="badge ok">Ativo</span><% } else { %><span class="badge neutral">Inativo</span><% } %></td>
            <td><form method="post" action="/admin/funcionarios/<%= f.id %>/toggle" style="margin:0"><button class="btn ghost sm" type="submit"><%= f.ativo ? 'Desativar' : 'Ativar' %></button></form></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<div class="hint-box">Se você tiver mais de um funcionário ativo, cada um vê o próprio ganho (etiquetas × a taxa dele). A coluna resumida de "taxa func." no painel do admin só aparece quando há um único funcionário ativo.</div>

<%- include('../partials/app-close') %>
