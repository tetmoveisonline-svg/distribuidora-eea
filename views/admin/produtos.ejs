<%- include('../partials/app-open', { titulo: 'Produtos', ativo: 'produtos' }) %>

<h2 class="title">Produtos</h2>
<p class="sub">Catálogo geral. Depois, em "Preços por cliente", você define o preço negociado de cada produto por cliente.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="grid2">
  <div class="card pad">
    <div class="section-title">Novo produto</div>
    <form method="post" action="/admin/produtos">
      <div class="field"><label>Nome do produto</label><input name="nome" placeholder="PAC até 300g" /></div>
      <div class="field"><label>Descrição (opcional)</label><input name="descricao" placeholder="Encomenda PAC até 300g" /></div>
      <button class="btn block" type="submit">Salvar produto</button>
    </form>
  </div>
  <div class="card pad">
    <div class="section-title">Catálogo</div>
    <% if (produtos.length === 0) { %><div class="empty">Nenhum produto ainda.</div><% } else { %>
    <table>
      <thead><tr><th>Produto</th><th>Descrição</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% produtos.forEach(function (p) { %>
          <tr>
            <td><%= p.nome %></td>
            <td class="dim"><%= p.descricao || '—' %></td>
            <td><% if (p.ativo) { %><span class="badge ok">Ativo</span><% } else { %><span class="badge neutral">Inativo</span><% } %></td>
            <td><form method="post" action="/admin/produtos/<%= p.id %>/toggle" style="margin:0"><button class="btn ghost sm" type="submit"><%= p.ativo ? 'Desativar' : 'Ativar' %></button></form></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<%- include('../partials/app-close') %>
