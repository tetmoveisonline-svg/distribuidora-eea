<%- include('../partials/app-open', { titulo: 'Clientes', ativo: 'clientes' }) %>

<style>
  /* ===== Clientes — tabela refinada (Opção 3) ===== */
  .cli-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
  .cli-toolbar .ferramentas { display:flex; align-items:center; gap:8px; margin-left:auto; flex-wrap:wrap; }
  .busca-wrap { position:relative; }
  .busca-wrap input { background:var(--field-bg); border:1px solid var(--field-border); border-radius:9px; padding:8px 12px 8px 30px; color:var(--text); font-size:13px; min-width:200px; outline:none; }
  .busca-wrap input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }
  .busca-wrap .ic { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--text-dim); font-size:13px; pointer-events:none; }
  .filtro-sel { background:var(--field-bg); border:1px solid var(--field-border); border-radius:9px; padding:8px 10px; color:var(--text); font-size:12.5px; cursor:pointer; outline:none; }

  .clientes-tbl { width:100%; border-collapse:collapse; }
  .clientes-tbl th { font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.4px; text-align:left; padding:10px 10px; font-weight:600; border-bottom:1px solid var(--border); }
  .clientes-tbl th.num, .clientes-tbl td.num { text-align:right; font-variant-numeric:tabular-nums; }
  .clientes-tbl td { padding:12px 10px; border-bottom:1px solid var(--border); vertical-align:middle; }
  .clientes-tbl tbody tr.linha:nth-of-type(odd) { background:rgba(127,127,127,.03); }
  .clientes-tbl tbody tr.linha:hover { background:var(--accent-soft); }
  .cli-cell { display:flex; align-items:center; gap:10px; }
  .ini { width:34px; height:34px; border-radius:9px; background:var(--panel); border:1px solid var(--border-strong); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:12.5px; color:var(--info); flex:none; }
  .cli-nome { font-weight:600; }
  .cli-login { color:var(--text-dim); font-size:12.5px; }
  .lim-txt { font-size:12px; margin-bottom:5px; }
  .bar { height:6px; border-radius:5px; background:var(--field-bg); overflow:hidden; border:1px solid var(--border); max-width:170px; }
  .bar > i { display:block; height:100%; background:var(--accent); }
  .acts { display:flex; gap:6px; justify-content:flex-end; }
  .btn.ico { background:transparent; border:1px solid var(--border-strong); color:var(--text-muted); padding:6px 9px; border-radius:8px; font-size:13px; line-height:1; cursor:pointer; }
  .btn.ico:hover { background:var(--field-bg); color:var(--text); }
  .btn.ico.perigo { color:var(--danger); border-color:color-mix(in srgb, var(--danger) 45%, var(--border-strong)); }
  .btn.ico.perigo:hover { background:var(--danger-soft); }
  .editor-row > td { background:var(--panel); padding:0 !important; border-bottom:1px solid var(--border); }
  .editor-box { padding:14px; }
  .nome-input { min-width:200px; }
  .cli-vazio { padding:26px; text-align:center; color:var(--text-dim); }
  @media (max-width:820px) {
    .clientes-tbl .col-login, .clientes-tbl .col-negoc { display:none; }
  }
</style>

<h2 class="title">Clientes</h2>
<p class="sub">Cada cliente tem login/senha próprios para subir as etiquetas.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>
<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>

<% if (acesso) { %>
<div class="card pad acesso-box" style="margin-bottom:16px">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
    <div class="section-title" style="margin:0">Mensagem de acesso para <%= acesso.nome %></div>
    <span class="dim" style="font-size:12px">A senha aparece só agora; depois ela não pode ser recuperada, apenas redefinida.</span>
  </div>
  <textarea id="acessoMsg" class="acesso-msg" readonly rows="11"><%= acesso.mensagem %></textarea>
  <div class="actions-inline" style="margin-top:10px">
    <button type="button" class="btn sm" id="acessoCopiar">Copiar mensagem</button>
    <% var wa = acesso.telefone ? ('https://wa.me/' + (acesso.telefone.length <= 11 ? '55' + acesso.telefone : acesso.telefone) + '?text=' + encodeURIComponent(acesso.mensagem)) : ('https://wa.me/?text=' + encodeURIComponent(acesso.mensagem)); %>
    <a class="btn sm whats" href="<%= wa %>" target="_blank" rel="noopener">Enviar no WhatsApp<%= acesso.telefone ? '' : ' (escolher contato)' %></a>
  </div>
</div>
<script>
  (function () {
    var b = document.getElementById('acessoCopiar'), t = document.getElementById('acessoMsg'); if (!b) return;
    b.addEventListener('click', function () {
      var done = function () { b.textContent = 'Copiado ✓'; setTimeout(function () { b.textContent = 'Copiar mensagem'; }, 2000); };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t.value).then(done).catch(function () { t.select(); document.execCommand('copy'); done(); });
      else { t.select(); document.execCommand('copy'); done(); }
    });
  })();
</script>
<% } %>

<div class="card pad">
  <div class="cli-toolbar">
    <div class="section-title" style="margin:0">Clientes cadastrados <span class="dim" style="font-weight:400">(<%= clientes.length %>)</span></div>
    <div class="ferramentas">
      <div class="busca-wrap"><span class="ic">🔍</span><input id="buscaCli" type="search" placeholder="Buscar cliente ou login…" autocomplete="off" /></div>
      <select id="filtroStatus" class="filtro-sel">
        <option value="todos">Status: todos</option>
        <option value="ativo">Só ativos</option>
        <option value="inativo">Só inativos</option>
      </select>
      <button type="button" class="btn" id="btnNovoCliente">+ Novo cliente</button>
    </div>
  </div>

  <% if (clientes.length === 0) { %>
    <div class="cli-vazio">Nenhum cliente ainda. Clique em “+ Novo cliente” para cadastrar o primeiro.</div>
  <% } else { %>
  <div style="overflow-x:auto">
    <table class="clientes-tbl">
      <thead><tr>
        <th>Cliente</th>
        <th class="col-login">Login</th>
        <th class="num col-negoc">Negoc.</th>
        <th>Em aberto / limite</th>
        <th>Prazo</th>
        <th>Status</th>
        <th style="text-align:right">Ações</th>
      </tr></thead>
      <tbody>
        <% clientes.forEach(function (c) {
             var ini = (c.nome || '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w[0] || ''; }).join('').toUpperCase() || '?';
        %>
          <tr class="linha" id="row-<%= c.id %>" data-busca="<%= (c.nome + ' ' + (c.login || '')).toLowerCase() %>" data-status="<%= c.ativo ? 'ativo' : 'inativo' %>">
            <td>
              <div class="nome-view cli-cell" id="nomeview-<%= c.id %>">
                <div class="ini"><%= ini %></div>
                <div>
                  <div class="cli-nome"><%= c.nome %></div>
                  <% if (c.telefone) { %><div class="cli-login">📱 <%= c.telefone %></div><% } %>
                </div>
              </div>
              <form method="post" action="/admin/clientes/<%= c.id %>/nome" class="nome-form" id="nomeform-<%= c.id %>" style="display:none;align-items:center;gap:7px;flex-wrap:wrap">
                <input name="nome" value="<%= c.nome %>" maxlength="120" required class="nome-input" />
                <button class="btn sm" type="submit">Salvar</button>
                <button type="button" class="btn ghost sm nome-cancel" data-id="<%= c.id %>">Cancelar</button>
              </form>
            </td>
            <td class="cli-login col-login"><%= c.login || '—' %></td>
            <td class="num col-negoc"><%= c.produtos %></td>
            <td>
              <% if (c.limite_centavos !== null) { var pct = c.limite_centavos > 0 ? Math.min(100, Math.round(c.em_aberto / c.limite_centavos * 100)) : 0; %>
                <div class="lim-txt"><%= formatBRL(c.em_aberto) %> <span class="dim">de <%= formatBRL(c.limite_centavos) %></span></div>
                <div class="bar"><i style="width:<%= Math.max(pct, 2) %>%<%= pct >= 100 ? ';background:var(--danger)' : (pct >= 80 ? ';background:var(--warn, #d2a33f)' : '') %>"></i></div>
              <% } else { %>
                <span class="dim">Sem limite<% if (c.em_aberto > 0) { %> · <%= formatBRL(c.em_aberto) %> em aberto<% } %></span>
              <% } %>
            </td>
            <td><%= c.prazo_dias %> dia<%= c.prazo_dias === 1 ? '' : 's' %><% if (!c.bloquear_vencido) { %><div style="margin-top:4px"><span class="badge" title="Este cliente lança etiquetas mesmo com boleto vencido" style="background:rgba(74,144,226,.14);color:#7fb3f0;border:1px solid #2b4d6e;font-size:10px;padding:2px 7px">🔓 Libera vencido</span></div><% } %></td>
            <td><% if (c.ativo) { %><span class="badge ok">Ativo</span><% } else { %><span class="badge neutral">Inativo</span><% } %></td>
            <td>
              <div class="acts">
                <button type="button" class="btn ico nome-edit" data-id="<%= c.id %>" title="Editar nome">✎</button>
                <button type="button" class="btn ico com-toggle" data-id="<%= c.id %>" title="Comissão (quem agregou)">%</button>
                <button type="button" class="btn ico prazo-toggle" data-id="<%= c.id %>" title="Prazo, limite e bloqueio">⚙</button>
                <form method="post" action="/admin/clientes/<%= c.id %>/toggle" style="margin:0"><button class="btn ico" type="submit" title="<%= c.ativo ? 'Desativar' : 'Ativar' %>"><%= c.ativo ? '⏸' : '▶' %></button></form>
                <button type="button" class="btn ico perigo btn-excluir-cli" data-id="<%= c.id %>" data-nome="<%= c.nome %>" data-pedidos="<%= c.pedidos %>" data-aberto="<%= formatBRL(c.em_aberto) %>" title="Excluir">🗑</button>
              </div>
            </td>
          </tr>

          <!-- Editor: comissão / quem agregou -->
          <tr class="editor-row com-row" id="com-<%= c.id %>" style="display:none">
            <td colspan="7">
              <div class="editor-box">
                <form method="post" action="/admin/clientes/<%= c.id %>/comissao">
                  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
                    <div class="field" style="margin:0;min-width:260px"><label>Agregado por</label>
                      <select name="representante_id" class="com-sel" data-cli="<%= c.id %>">
                        <option value="">— sem comissão —</option>
                        <% reps.forEach(function (r) { %>
                          <option value="<%= r.id %>" data-prep="<%= r.representante_pai_id ? 1 : 0 %>" <%= c.representante_id === r.id ? 'selected' : '' %>><%= r.nome %><%= r.representante_pai_id ? ' (preposto de ' + (r.pai_nome || '') + ')' : '' %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="field" style="margin:0;width:150px"><label>Comissão total %</label><input name="total" value="<%= c.comissao_total_bps ? (c.comissao_total_bps / 100) : '' %>" placeholder="ex.: 5" /></div>
                    <div class="field com-prep" style="margin:0;width:150px" data-cli="<%= c.id %>"><label>% do preposto</label><input name="preposto" value="<%= c.comissao_preposto_bps != null ? (c.comissao_preposto_bps / 100) : '' %>" placeholder="ex.: 4" /></div>
                    <button class="btn sm" type="submit">Salvar comissão</button>
                  </div>
                  <div class="dim" style="font-size:11.5px;margin-top:6px">Preposto: informe quanto fica com ele; o restante do total vai para o representante dele. Vale para os próximos pedidos deste cliente.</div>
                </form>
              </div>
            </td>
          </tr>

          <!-- Editor: prazo / limite / bloqueio -->
          <tr class="editor-row prazo-row" id="prazo-<%= c.id %>" style="display:none">
            <td colspan="7">
              <div class="editor-box">
                <form method="post" action="/admin/clientes/<%= c.id %>/prazo">
                  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
                    <div class="field" style="margin:0;width:170px"><label>Prazo de pagamento (dias)</label><input name="prazo_dias" type="number" min="0" max="365" value="<%= c.prazo_dias %>" /></div>
                    <div class="field" style="margin:0;width:190px"><label>Limite de crédito (R$)</label><input name="limite" value="<%= c.limite_centavos === null ? '' : (c.limite_centavos / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>" placeholder="vazio = sem limite" /></div>
                    <label class="field" style="margin:0;flex-direction:row;align-items:center;gap:7px;width:auto"><input type="checkbox" name="permitir_vencido" value="1" <%= c.bloquear_vencido ? '' : 'checked' %> style="width:auto" /> <span style="font-size:12.5px">Permitir lançar mesmo com pedido vencido</span></label>
                    <button class="btn sm" type="submit">Salvar</button>
                  </div>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="cli-vazio" id="semResultado" style="display:none">Nenhum cliente encontrado para esse filtro.</div>
  <% } %>
</div>

<!-- Modal: Novo cliente -->
<div class="overlay" id="novoOverlay">
  <div class="card pad modal" style="max-width:520px">
    <h2 class="title" style="margin-bottom:4px">Novo cliente</h2>
    <p class="sub" style="margin-bottom:16px">Login e senha próprios para o cliente subir as etiquetas.</p>
    <form method="post" action="/admin/clientes">
      <div class="field"><label>Nome / empresa</label><input name="nome" placeholder="Loja do Cliente Ltda" required /></div>
      <div class="field"><label>E-mail</label><input name="email" placeholder="cliente@email.com" /></div>
      <div class="field"><label>WhatsApp (DDD + número)</label><input name="telefone" placeholder="17999990000" inputmode="numeric" /></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <div class="field" style="flex:1;min-width:150px"><label>Login</label><input name="login" placeholder="loja.cliente" required /></div>
        <div class="field" style="flex:1;min-width:150px"><label>Senha</label><input name="senha" placeholder="definir senha" required /></div>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <div class="field" style="flex:1;min-width:150px"><label>Prazo (dias após o aceite)</label><input name="prazo_dias" type="number" min="0" max="365" value="7" /></div>
        <div class="field" style="flex:1;min-width:150px"><label>Limite de crédito (R$)</label><input name="limite" placeholder="5.000,00 (vazio = sem limite)" /></div>
      </div>
      <label class="field" style="flex-direction:row;align-items:flex-start;gap:9px;margin-top:2px"><input type="checkbox" name="permitir_vencido" value="1" style="width:auto;margin-top:2px" /> <span style="font-size:12.5px;line-height:1.4">Permitir lançar mesmo com pedido vencido <span class="dim">— padrão: fica bloqueado até regularizar</span></span></label>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px">
        <button class="btn ghost" type="button" id="novoCancelar">Cancelar</button>
        <button class="btn" type="submit">Salvar cliente</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: excluir cliente com senha do admin -->
<div class="overlay" id="excluirOverlay">
  <div class="card pad modal" style="max-width:520px">
    <h2 class="title">Excluir cliente</h2>
    <p class="sub">Você vai excluir <b id="exNome"></b> com <b id="exPedidos"></b> pedido(s) e <b id="exAberto"></b> em aberto no financeiro. Login, preços, pedidos, etiquetas, comprovantes e lançamentos serão apagados. <b>Não tem volta.</b></p>
    <div class="hint-box" style="margin:0 0 14px">Se a intenção é só impedir novos envios, use “Desativar” (⏸): o histórico fica guardado.</div>
    <form method="post" id="exForm" action="#">
      <div class="field">
        <label for="exSenha">Confirme com a sua senha de administrador</label>
        <input id="exSenha" name="senha" type="password" autocomplete="current-password" required />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button class="btn ghost" type="button" id="exCancelar">Cancelar</button>
        <button class="btn danger" type="submit">Excluir definitivamente</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    // ----- Modal novo cliente -----
    var novoOv = document.getElementById('novoOverlay');
    var btnNovo = document.getElementById('btnNovoCliente');
    if (btnNovo && novoOv) {
      btnNovo.addEventListener('click', function () { novoOv.classList.add('on'); setTimeout(function () { var f = novoOv.querySelector('input[name="nome"]'); if (f) f.focus(); }, 30); });
      document.getElementById('novoCancelar').addEventListener('click', function () { novoOv.classList.remove('on'); });
      novoOv.addEventListener('click', function (e) { if (e.target === novoOv) novoOv.classList.remove('on'); });
    }

    // ----- Modal excluir -----
    var ov = document.getElementById('excluirOverlay');
    var form = document.getElementById('exForm');
    document.querySelectorAll('.btn-excluir-cli').forEach(function (b) {
      b.addEventListener('click', function () {
        document.getElementById('exNome').textContent = b.getAttribute('data-nome');
        document.getElementById('exPedidos').textContent = b.getAttribute('data-pedidos');
        document.getElementById('exAberto').textContent = b.getAttribute('data-aberto');
        form.action = '/admin/clientes/' + b.getAttribute('data-id') + '/excluir';
        document.getElementById('exSenha').value = '';
        ov.classList.add('on');
        setTimeout(function () { document.getElementById('exSenha').focus(); }, 30);
      });
    });
    document.getElementById('exCancelar').addEventListener('click', function () { ov.classList.remove('on'); });
    ov.addEventListener('click', function (e) { if (e.target === ov) ov.classList.remove('on'); });

    // Fecha qualquer modal com Esc.
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { ov.classList.remove('on'); if (novoOv) novoOv.classList.remove('on'); } });

    // ----- Editores inline (abre um por vez por cliente) -----
    function fecharEditores(id) {
      var com = document.getElementById('com-' + id), pz = document.getElementById('prazo-' + id);
      if (com) com.style.display = 'none';
      if (pz) pz.style.display = 'none';
      var v = document.getElementById('nomeview-' + id), f = document.getElementById('nomeform-' + id);
      if (v && f) { v.style.display = ''; f.style.display = 'none'; }
    }
    // Nome
    function nomeMostra(id, editando) {
      var v = document.getElementById('nomeview-' + id), f = document.getElementById('nomeform-' + id);
      if (!v || !f) return;
      if (editando) fecharEditores(id);
      v.style.display = editando ? 'none' : '';
      f.style.display = editando ? 'flex' : 'none';
      if (editando) { var inp = f.querySelector('input[name="nome"]'); if (inp) { inp.focus(); inp.select(); } }
    }
    document.querySelectorAll('.nome-edit').forEach(function (b) {
      b.addEventListener('click', function () { nomeMostra(b.getAttribute('data-id'), true); });
    });
    document.querySelectorAll('.nome-cancel').forEach(function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-id'), f = document.getElementById('nomeform-' + id);
        if (f) { var inp = f.querySelector('input[name="nome"]'); if (inp) inp.value = inp.defaultValue; }
        nomeMostra(id, false);
      });
    });
    // Comissão (%) e Prazo (⚙): alternam a linha-editor
    function toggleEditor(id, qual) {
      var row = document.getElementById(qual + '-' + id);
      if (!row) return;
      var abrir = row.style.display === 'none' || !row.style.display;
      fecharEditores(id);
      row.style.display = abrir ? '' : 'none';
      if (abrir && qual === 'com') { var s = row.querySelector('.com-sel'); if (s) syncPrep(s); }
    }
    document.querySelectorAll('.com-toggle').forEach(function (b) { b.addEventListener('click', function () { toggleEditor(b.getAttribute('data-id'), 'com'); }); });
    document.querySelectorAll('.prazo-toggle').forEach(function (b) { b.addEventListener('click', function () { toggleEditor(b.getAttribute('data-id'), 'prazo'); }); });

    // Mostra o campo "% do preposto" só quando o selecionado for preposto.
    function syncPrep(sel) {
      var cli = sel.getAttribute('data-cli');
      var opt = sel.options[sel.selectedIndex];
      var ehPrep = opt && opt.getAttribute('data-prep') === '1';
      var box = document.querySelector('.com-prep[data-cli="' + cli + '"]');
      if (box) box.style.display = ehPrep ? '' : 'none';
    }
    document.querySelectorAll('.com-sel').forEach(function (s) { syncPrep(s); s.addEventListener('change', function () { syncPrep(s); }); });

    // ----- Busca + filtro de status -----
    var busca = document.getElementById('buscaCli'), filtro = document.getElementById('filtroStatus'), semRes = document.getElementById('semResultado');
    function aplicarFiltro() {
      var q = (busca && busca.value || '').trim().toLowerCase();
      var st = filtro && filtro.value || 'todos';
      var achou = 0;
      document.querySelectorAll('tr.linha').forEach(function (tr) {
        var id = tr.id.replace('row-', '');
        var okBusca = !q || (tr.getAttribute('data-busca') || '').indexOf(q) !== -1;
        var okStatus = st === 'todos' || tr.getAttribute('data-status') === st;
        var mostra = okBusca && okStatus;
        tr.style.display = mostra ? '' : 'none';
        if (!mostra) fecharEditores(id); // esconde editores de linhas filtradas
        if (mostra) achou++;
      });
      if (semRes) semRes.style.display = achou === 0 ? '' : 'none';
    }
    if (busca) busca.addEventListener('input', aplicarFiltro);
    if (filtro) filtro.addEventListener('change', aplicarFiltro);
  })();
</script>

<%- include('../partials/app-close') %>
