<% var ehEdit = (typeof edit !== 'undefined' && edit); %>
<%- include('../partials/app-open', { titulo: ehEdit ? ('Editar retirada ' + edit.numero) : 'Nova retirada no CD', ativo: 'pedidos' }) %>

<style>
  .ret-rows{margin-top:6px}
  .ret-row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;padding:12px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px;background:var(--panel)}
  .ret-row .f{display:flex;flex-direction:column;gap:5px}
  .ret-row .f.prod{flex:1 1 230px}
  .ret-row .f.cor{flex:1 1 150px}
  .ret-row .lbl{font-size:11px;color:var(--text-dim)}
  .ret-row select,.ret-row input{background:var(--field-bg);border:1px solid var(--field-border);border-radius:8px;padding:8px 10px;color:var(--text);font-size:13.5px}
  .ret-row .qtd{width:72px;text-align:right}
  .ret-row .vendainp{width:104px;text-align:right}
  .ret-row .venda-lbl{color:var(--gold)}
  .ret-row .vhint{font-size:10.5px;color:var(--text-dim);margin-top:4px;white-space:nowrap}
  .ret-row .val{font-size:13.5px;padding:8px 0;min-width:90px;text-align:right}
  .ret-row .rm{background:transparent;border:none;color:var(--danger);font-size:12.5px;cursor:pointer;padding:8px 2px}
  .ret-nf{margin-top:14px;border:1px solid var(--gold);border-radius:10px;padding:12px 14px;background:var(--gold-soft)}
  .ret-nf .tag{display:flex;align-items:center;gap:10px}
  .ret-nf input[type=number]{width:70px;background:var(--field-bg);border:1px solid var(--field-border);border-radius:7px;padding:6px 8px;color:var(--text)}
  .ret-nf .res{font-size:12.5px;color:var(--text-dim);margin-top:8px}
  .ret-pg{margin-top:14px;border:1px solid var(--border);border-radius:10px;padding:12px 14px;background:var(--panel)}
  .ret-pg .rowp{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  .ret-pg .f{display:flex;flex-direction:column;gap:5px}
  .ret-pg .plbl{font-size:11px;color:var(--text-dim)}
  .ret-pg select,.ret-pg input{background:var(--field-bg);border:1px solid var(--field-border);border-radius:8px;padding:8px 10px;color:var(--text);font-size:13.5px}
  .ret-pg input[type=number]{width:84px}
  .ret-pg table{width:100%;border-collapse:collapse}
  .ret-pg th{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;text-align:left;padding:6px 6px;font-weight:600}
  .ret-pg th.n,.ret-pg td.n{text-align:right}
  .ret-pg td{font-size:12.5px;padding:7px 6px;border-top:1px solid var(--border)}
  .ret-pg td input[type=date]{padding:6px 8px}
</style>

<h2 class="title"><%= ehEdit ? ('Editar retirada ' + edit.numero) : 'Nova retirada no CD' %></h2>
<p class="sub"><% if (ehEdit) { %>Ajuste os produtos/quantidades e o parcelamento. O estoque é reajustado ao salvar. (A nota fiscal e o cliente são mantidos.)<% } else { %>Para clientes que retiram a mercadoria no seu centro de distribuição. Você monta o pedido direto, sem etiquetas. O estoque só baixa quando você confirmar a retirada.<% } %></p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="card pad">
  <form id="retForm" method="post" action="<%= ehEdit ? ('/admin/pedido/' + edit.pedidoId + '/editar') : '/admin/retirada' %>">
    <div class="field"><label for="cliente">Cliente</label>
      <select id="cliente" name="clienteId" required <%= ehEdit ? 'disabled' : '' %>>
        <option value="">— escolha o cliente —</option>
        <% clientes.forEach(function (c) { %><option value="<%= c.id %>" <%= ehEdit && c.id === edit.clienteId ? 'selected' : '' %>><%= c.nome %></option><% }); %>
      </select>
    </div>

    <label class="lbl" style="font-size:12px;color:var(--text-dim);display:block;margin:8px 0 6px">Produtos da retirada</label>
    <div id="rows" class="ret-rows"></div>
    <div id="semCliente" class="dim" style="font-size:12.5px">Escolha um cliente para carregar os produtos.</div>
    <button type="button" class="btn ghost sm" id="addRow" style="display:none;margin-top:4px">+ adicionar produto</button>

    <% if (nfBps > 0 && !ehEdit) { %>
    <div class="ret-nf" id="nfBox">
      <label class="tag"><input type="checkbox" id="nfCheck" /> <span style="font-weight:600">🧾 Com nota fiscal</span>
        <span style="margin-left:auto;display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text-dim)" id="nfPctWrap">% com NF (mín. 30%) <input type="number" id="nfParcela" min="30" max="100" value="30" /> %</span>
      </label>
      <div class="res" id="nfResumo"></div>
      <div class="dim" style="font-size:11px;margin-top:4px">Imposto de <%= (nfBps % 100 === 0 ? (nfBps/100) : (nfBps/100).toFixed(2).replace('.', ',')) %>% sobre a parcela escolhida. Entra no total a pagar.</div>
    </div>
    <% } else if (ehEdit && edit.comNf) { %>
    <div class="ret-nf" style="opacity:.9"><span style="font-weight:600">🧾 Com nota fiscal <%= (edit.nfParcelaBps/100) %>%</span> <span class="dim" style="font-size:12px">— mantida. O imposto é recalculado sobre o novo valor.</span></div>
    <% } %>

    <div class="ret-pg" id="pgBox">
      <div class="rowp">
        <div class="f"><span class="plbl">Pagamento</span>
          <select id="pgForma"><option value="avista">À vista</option><option value="parcelado">Parcelado</option></select>
        </div>
        <div class="f pgonly" style="display:none"><span class="plbl">Parcelas</span><input type="number" id="pgN" min="2" max="24" value="3" /></div>
        <div class="f pgonly" style="display:none"><span class="plbl">Dias entre elas</span><input type="number" id="pgDias" min="1" max="365" value="30" /></div>
        <div class="f pgonly" style="display:none"><span class="plbl">1º vencimento</span><input type="date" id="pgPrimeiro" /></div>
        <button type="button" class="btn ghost sm pgonly" id="pgGerar" style="display:none">↻ Gerar datas</button>
      </div>
      <div id="pgParcelas" style="margin-top:10px"></div>
    </div>

    <div class="totalbar" style="margin-top:14px">
      <div class="muted" id="resumoLinha">0 itens</div>
      <div class="big" id="grandTotal">R$ 0,00</div>
    </div>

    <input type="hidden" name="itens" id="itensJson" />
    <input type="hidden" name="comNf" id="comNfHidden" value="false" />
    <input type="hidden" name="nfParcela" id="nfParcelaHidden" value="" />
    <input type="hidden" name="parcelas" id="parcelasHidden" value="1" />
    <input type="hidden" name="parcelaVencs" id="parcelaVencsHidden" value="" />

    <div style="display:flex;gap:10px;margin-top:14px">
      <a class="btn ghost" href="<%= ehEdit ? ('/admin/pedido/' + edit.pedidoId) : '/admin/pedidos' %>">Cancelar</a>
      <button class="btn" type="submit" id="criar" disabled><%= ehEdit ? 'Salvar alterações' : 'Criar retirada' %></button>
    </div>
  </form>
</div>

<script>
(function () {
  var NF_BPS = <%- jsonForScript(nfBps || 0) %>;
  var EDIT = <%- ehEdit ? jsonForScript(edit) : 'null' %>;
  var itens = [];           // catalogo do cliente
  var rows = [];            // [{itemId, corId, qtd}]
  var elRows = document.getElementById('rows');
  var elAdd = document.getElementById('addRow');
  var elSem = document.getElementById('semCliente');
  var elCriar = document.getElementById('criar');

  function brl(c){ return 'R$ ' + (Number(c||0)/100).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function precoFmt(c){ return (Number(c||0)/100).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  // "1.950,06" / "195,06" / "195" -> centavos (ou null se vazio/inválido)
  function parseVenda(s){ if(s==null) return null; var t=String(s).trim(); if(t==='') return null; t=t.replace(/\./g,'').replace(',','.').replace(/[^0-9.]/g,''); if(t==='') return null; var v=parseFloat(t); if(isNaN(v)) return null; return Math.round(v*100); }
  // preço cobrado na linha: venda se preenchida e maior que o sistema; senão o preço de sistema
  function precoLinha(row, it){ var base=it?Number(it.preco_centavos||0):0; var v=parseVenda(row&&row.venda); return (v!=null && v>base)? v : base; }
  function itemById(id){ for (var i=0;i<itens.length;i++){ if(String(itens[i].id)===String(id)) return itens[i]; } return null; }
  function nfPct(){ var el=document.getElementById('nfParcela'); var v=parseInt(el&&el.value,10); if(isNaN(v))v=30; if(v<30)v=30; if(v>100)v=100; return v; }

  function carregarItens(id, done){
    rows=[]; itens=[];
    if(!id){ elRows.innerHTML=''; elSem.style.display='block'; elAdd.style.display='none'; render(); return; }
    fetch('/admin/retirada/itens?cliente='+encodeURIComponent(id)).then(function(r){return r.json();}).then(function(d){
      itens = (d && d.itens) || [];
      elSem.style.display = itens.length? 'none':'block';
      if(!itens.length){ elSem.textContent='Este cliente não tem produtos com preço. Cadastre em Preços por cliente.'; }
      elAdd.style.display = itens.length? 'inline-block':'none';
      if(done){ done(); } else { if(itens.length){ rows=[{itemId:itens[0].id, corId:null, qtd:1}]; } render(); }
    }).catch(function(){ elSem.textContent='Falha ao carregar os produtos.'; elSem.style.display='block'; });
  }
  function itemByProduto(pid){ for(var i=0;i<itens.length;i++){ if(Number(itens[i].produto_id)===Number(pid)) return itens[i]; } return null; }
  document.getElementById('cliente').addEventListener('change', function(){ carregarItens(this.value); });

  elAdd.addEventListener('click', function(){ if(itens.length){ rows.push({itemId:itens[0].id, corId:null, qtd:1}); render(); } });

  function render(){
    var html='';
    rows.forEach(function(row, idx){
      var it=itemById(row.itemId)||{preco_centavos:0,cores:[]};
      var opts=itens.map(function(x){ return '<option value="'+x.id+'"'+(String(x.id)===String(row.itemId)?' selected':'')+'>'+esc(x.nome)+' — '+brl(x.preco_centavos)+'</option>'; }).join('');
      var corHtml='';
      if(it.cores && it.cores.length){
        var co='<option value="">— cor —</option>'+it.cores.map(function(c){ return '<option value="'+c.id+'"'+(c.id===row.corId?' selected':'')+'>'+esc(c.nome)+(c.sku?' · '+esc(c.sku):'')+' · '+c.saldo+' disp.</option>'; }).join('');
        corHtml='<div class="f cor"><span class="lbl">Cor</span><select data-idx="'+idx+'" class="selcor">'+co+'</select></div>';
      }
      var base=Number(it.preco_centavos||0);
      var precoUnit=precoLinha(row, it);
      var acr=precoUnit-base;
      var total=precoUnit*(row.qtd||0);
      var hint = acr>0 ? ('sistema '+brl(base)+' · +'+brl(acr)) : ('sistema '+brl(base));
      html+='<div class="ret-row">'+
        '<div class="f prod"><span class="lbl">Produto</span><select data-idx="'+idx+'" class="selprod">'+opts+'</select></div>'+
        corHtml+
        '<div class="f"><span class="lbl">Qtd</span><input data-idx="'+idx+'" class="qtd qtdinp" value="'+(row.qtd||1)+'" inputmode="numeric" /></div>'+
        '<div class="f"><span class="lbl venda-lbl">Preço de venda ✎</span><input data-idx="'+idx+'" class="vendainp" value="'+esc(row.venda||'')+'" placeholder="'+precoFmt(base)+'" inputmode="decimal" /><div class="vhint">'+hint+'</div></div>'+
        '<div class="f"><span class="lbl">Total</span><div class="val">'+brl(total)+'</div></div>'+
        '<button type="button" class="rm" data-idx="'+idx+'">remover</button>'+
      '</div>';
    });
    elRows.innerHTML=html;
    elRows.querySelectorAll('.selprod').forEach(function(el){ el.addEventListener('change',function(){ var r=rows[+el.dataset.idx]; r.itemId=el.value; r.corId=null; render(); }); });
    elRows.querySelectorAll('.selcor').forEach(function(el){ el.addEventListener('change',function(){ rows[+el.dataset.idx].corId=el.value?parseInt(el.value,10):null; render(); }); });
    elRows.querySelectorAll('.qtdinp').forEach(function(el){ el.addEventListener('change',function(){ var v=parseInt(el.value,10); rows[+el.dataset.idx].qtd=(!v||v<1)?1:v; render(); }); });
    elRows.querySelectorAll('.vendainp').forEach(function(el){ el.addEventListener('change',function(){ rows[+el.dataset.idx].venda=el.value; render(); }); });
    elRows.querySelectorAll('.rm').forEach(function(el){ el.addEventListener('click',function(){ rows.splice(+el.dataset.idx,1); render(); }); });
    totals();
  }

  function faltaCor(row){ var it=itemById(row.itemId); return !!(it && it.cores && it.cores.length>0 && !it.cores.find(function(c){return c.id===row.corId;})); }

  function totals(){
    var base=0, qtd=0;
    rows.forEach(function(r){ var it=itemById(r.itemId)||{preco_centavos:0}; base+=precoLinha(r,it)*(r.qtd||0); qtd+=(r.qtd||0); });
    var comNf = NF_BPS>0 && document.getElementById('nfCheck') && document.getElementById('nfCheck').checked;
    var imposto=0, parcelaC=0;
    if(EDIT && EDIT.comNf){ parcelaC=Math.round(base*(EDIT.nfParcelaBps/10000)); imposto=Math.round(base*(EDIT.nfParcelaBps/10000)*(EDIT.nfBps/10000)); comNf=true; }
    else if(comNf){ var pct=nfPct(); parcelaC=Math.round(base*pct/100); imposto=Math.round(parcelaC*NF_BPS/10000); }
    var total=base+imposto;
    document.getElementById('resumoLinha').innerHTML = qtd+' itens'+(comNf? ' · parcela com NF '+brl(parcelaC)+' · imposto '+brl(imposto):'');
    document.getElementById('grandTotal').textContent = brl(total);
    var nfr=document.getElementById('nfResumo'); if(nfr) nfr.textContent = comNf? ('Parcela com NF: '+brl(parcelaC)+' · imposto: '+brl(imposto)+' · total a pagar: '+brl(total)) : '';
    curTotal = total;
    renderPg();
    var semCor = rows.some(faltaCor);
    elCriar.disabled = rows.length===0 || qtd===0 || semCor || !pgValido();
    elCriar.title = semCor? 'Escolha a cor de cada produto' : (!pgValido()? 'Preencha as datas das parcelas' : '');
  }

  var nfc=document.getElementById('nfCheck'); if(nfc) nfc.addEventListener('change',totals);
  var nfp=document.getElementById('nfParcela'); if(nfp){ nfp.addEventListener('input',totals); nfp.addEventListener('change',function(){ nfp.value=nfPct(); totals(); }); }

  // ---------- Pagamento: à vista ou parcelado ----------
  var curTotal = 0;
  var pgVencs = [];            // ['YYYY-MM-DD', ...]
  var elForma=document.getElementById('pgForma'), elN=document.getElementById('pgN'), elDias=document.getElementById('pgDias'), elPrim=document.getElementById('pgPrimeiro'), elPgList=document.getElementById('pgParcelas');
  function parcelado(){ return elForma && elForma.value==='parcelado'; }
  function nParc(){ var v=parseInt(elN&&elN.value,10); if(isNaN(v)||v<2)v=2; if(v>24)v=24; return v; }
  function diasP(){ var v=parseInt(elDias&&elDias.value,10); if(isNaN(v)||v<1)v=1; if(v>365)v=365; return v; }
  function hojeMais(d){ var t=new Date(); t.setDate(t.getDate()+d); return t.toISOString().slice(0,10); }
  function addDias(iso,d){ var p=iso.split('-'); var t=new Date(Number(p[0]),Number(p[1])-1,Number(p[2])); t.setDate(t.getDate()+d); var y=t.getFullYear(),m=('0'+(t.getMonth()+1)).slice(-2),dd=('0'+t.getDate()).slice(-2); return y+'-'+m+'-'+dd; }
  function brDate(iso){ if(!iso) return '—'; var p=iso.split('-'); return p[2]+'/'+p[1]+'/'+p[0]; }
  function gerarDatas(){ var n=nParc(), dias=diasP(); var prim=(elPrim&&elPrim.value)||hojeMais(7); pgVencs=[]; for(var i=0;i<n;i++){ pgVencs.push(i===0?prim:addDias(prim,dias*i)); } }
  function valoresParcela(){ var n=nParc(); var base=Math.floor(curTotal/n); var resto=curTotal-base*n; var out=[]; for(var i=0;i<n;i++){ out.push(base+(i<resto?1:0)); } return out; }
  function pgValido(){ if(!parcelado()) return true; var n=nParc(); if(pgVencs.length!==n) return false; for(var i=0;i<n;i++){ if(!/^\d{4}-\d{2}-\d{2}$/.test(pgVencs[i]||'')) return false; } return true; }
  function renderPg(){
    var on=parcelado();
    document.querySelectorAll('.pgonly').forEach(function(el){ el.style.display= on? (el.tagName==='BUTTON'?'inline-block':'flex') : 'none'; });
    if(!on){ elPgList.innerHTML=''; return; }
    if(pgVencs.length!==nParc()) gerarDatas();
    if(elPrim && !elPrim.value) elPrim.value=pgVencs[0]||hojeMais(7);
    var vals=valoresParcela();
    var h='<table><thead><tr><th>Parcela</th><th>Vencimento</th><th class="n">Valor</th></tr></thead><tbody>';
    for(var i=0;i<nParc();i++){ h+='<tr><td>'+(i+1)+' de '+nParc()+'</td><td><input type="date" data-i="'+i+'" class="pgdt" value="'+(pgVencs[i]||'')+'" /></td><td class="n">'+brl(vals[i])+'</td></tr>'; }
    h+='</tbody></table><div class="dim" style="font-size:11px;margin-top:6px">Cada data é editável. Total '+brl(curTotal)+' em '+nParc()+'x.</div>';
    elPgList.innerHTML=h;
    elPgList.querySelectorAll('.pgdt').forEach(function(el){ el.addEventListener('change',function(){ pgVencs[+el.dataset.i]=el.value; totals(); }); });
  }
  if(elForma) elForma.addEventListener('change',function(){ if(parcelado()){ if(elPrim&&!elPrim.value) elPrim.value=hojeMais(7); gerarDatas(); } totals(); });
  if(elN) elN.addEventListener('change',function(){ gerarDatas(); totals(); });
  if(elDias) elDias.addEventListener('change',function(){ gerarDatas(); totals(); });
  if(elPrim) elPrim.addEventListener('change',function(){ gerarDatas(); totals(); });
  var elGerar=document.getElementById('pgGerar'); if(elGerar) elGerar.addEventListener('click',function(){ gerarDatas(); totals(); });

  document.getElementById('retForm').addEventListener('submit', function(e){
    var comNf = NF_BPS>0 && nfc && nfc.checked;
    document.getElementById('itensJson').value = JSON.stringify(rows.map(function(r){ return {itemId:r.itemId, corId:r.corId, quantidade:r.qtd, precoVenda:(r.venda||'')}; }));
    document.getElementById('comNfHidden').value = comNf? 'true':'false';
    document.getElementById('nfParcelaHidden').value = comNf? (nfPct()*100) : '';
    document.getElementById('parcelasHidden').value = parcelado()? nParc() : 1;
    document.getElementById('parcelaVencsHidden').value = parcelado()? JSON.stringify(pgVencs) : '';
  });

  // ---------- Modo edição: pré-preenche produtos e parcelas ----------
  if (EDIT) {
    carregarItens(EDIT.clienteId, function(){
      rows = (EDIT.itens||[]).map(function(e){ var it=itemByProduto(e.produtoId); return { itemId: it? it.id : (itens[0]&&itens[0].id), corId: e.corId, qtd: e.quantidade, venda: e.venda||'' }; }).filter(function(r){ return r.itemId!=null; });
      if (EDIT.parcelaVencs && EDIT.parcelaVencs.length){
        elForma.value='parcelado'; if(elN) elN.value=EDIT.parcelaVencs.length; pgVencs=EDIT.parcelaVencs.slice(); if(elPrim) elPrim.value=pgVencs[0]||'';
      } else { elForma.value='avista'; }
      render();
    });
  }
})();
</script>

<%- include('../partials/app-close') %>
