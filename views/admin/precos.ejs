<%- include('../partials/app-open', { titulo: 'Preços por cliente', ativo: 'precos' }) %>

<h2 class="title">Preços por cliente</h2>
<p class="sub">Para cada cliente, escolha os produtos do catálogo e defina o preço negociado. É o que o cliente vê ao subir a etiqueta.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="card pad" style="margin-bottom:16px">
  <form method="get" action="/admin/precos">
    <div class="field" style="max-width:340px;margin:0">
      <label>Cliente</label>
      <select name="cliente" onchange="this.form.submit()">
        <% if (clientes.length === 0) { %><option>— nenhum cliente ativo —</option><% } %>
        <% clientes.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= clienteId === c.id ? 'selected' : '' %>><%= c.nome %></option>
        <% }); %>
      </select>
    </div>
  </form>
</div>

<% if (clienteId) { %>
<div class="grid2">
  <div class="card pad">
    <div class="section-title">Adicionar preço</div>
    <form method="post" action="/admin/precos">
      <input type="hidden" name="cliente_id" value="<%= clienteId %>" />
      <div class="field"><label>Produto</label>
        <select name="produto_id">
          <% if (produtos.length === 0) { %><option value="">— cadastre um produto antes —</option><% } %>
          <% produtos.forEach(function (p) { %><option value="<%= p.id %>"><%= p.nome %></option><% }); %>
        </select>
      </div>
      <div class="field"><label>Preço negociado (R$)</label><input name="preco" placeholder="4,50" /></div>
      <button class="btn block" type="submit">Adicionar</button>
    </form>
  </div>
  <div class="card pad">
    <div class="section-title">Preços de <%= clienteNome %></div>
    <% if (itens.length === 0) { %><div class="empty">Nenhum preço cadastrado para este cliente.</div><% } else { %>
    <table>
      <thead><tr><th>Produto</th><th class="num">Preço</th><th></th></tr></thead>
      <tbody>
        <% itens.forEach(function (i) { %>
          <tr>
            <td><%= i.nome %></td>
            <td class="num"><%= formatBRL(i.preco_centavos) %></td>
            <td><form method="post" action="/admin/precos/<%= i.id %>/remove" style="margin:0"><button class="btn ghost sm" type="submit">Remover</button></form></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<% } else { %>
  <div class="card pad"><div class="empty">Cadastre um cliente ativo para definir preços.</div></div>
<% } %>

<%- include('../partials/app-close') %>
