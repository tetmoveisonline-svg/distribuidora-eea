<%- include('../partials/app-open', { titulo: 'Preços por cliente', ativo: 'precos' }) %>

<h2 class="title">Preços por cliente</h2>
<p class="sub">Para cada cliente, escolha os produtos do catálogo e defina o preço negociado. É o que o cliente vê ao subir a etiqueta.</p>

<% if (erro) { %><div class="alert err"><%= erro %></div><% } %>
<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>

<div class="card pad" style="margin-bottom:16px">
  <form method="get" action="/admin/precos">
    <div class="field" style="max-width:340px;margin:0">
      <label>Cliente</label>
      <select name="cliente" onchange="this.form.submit()">
        <% if (clientes.length === 0) { %><option>— nenhum cliente ativo —</option><% } %>
        <% clientes.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= clienteId === c.id ? 'selected' : '' %>><%= c.nome %></option>
        <% }); %>
      </select>
    </div>
  </form>
</div>

<% if (clienteId) { %>
<div class="grid2">
  <div class="card pad">
    <div class="section-title">Adicionar preço</div>
    <form method="post" action="/admin/precos">
      <input type="hidden" name="cliente_id" value="<%= clienteId %>" />
      <div class="field"><label>Produto</label>
        <select name="produto_id">
          <% if (produtos.length === 0) { %><option value="">— cadastre um produto antes —</option><% } %>
          <% produtos.forEach(function (p) { %><option value="<%= p.id %>"><%= p.nome %></option><% }); %>
        </select>
      </div>
      <div class="field"><label>Preço negociado (R$)</label><input name="preco" placeholder="4,50" /></div>
      <button class="btn block" type="submit">Adicionar</button>
    </form>
  </div>
  <div class="card pad">
    <div class="section-title">Preços de <%= clienteNome %></div>
    <% if (itens.length === 0) { %><div class="empty">Nenhum preço cadastrado para este cliente.</div><% } else { %>
    <table>
      <thead><tr><th>Produto</th><th class="num">Preço</th><th>Promoção</th><th></th></tr></thead>
      <tbody>
        <% itens.forEach(function (i) { %>
          <tr>
            <td><%= i.nome %></td>
            <td class="num">
              <% if (i.efetivo.promo) { %>
                <b style="color:var(--ok)"><%= formatBRL(i.efetivo.preco_centavos) %></b>
                <div class="dim" style="font-size:11.5px;text-decoration:line-through"><%= formatBRL(i.preco_centavos) %></div>
              <% } else { %><%= formatBRL(i.preco_centavos) %><% } %>
            </td>
            <td>
              <% if (i.promo_tipo) { %>
                <div style="margin-bottom:6px">
                  <% if (i.efetivo.promo) { %><span class="badge ok">Ativa</span>
                  <% } else if (i.promoEstado === 'agendada') { %><span class="badge warn">Agendada</span>
                  <% } else { %><span class="badge neutral">Encerrada</span><% } %>
                  <span class="dim" style="font-size:12px">
                    <%= i.promo_tipo === 'percentual' ? formatPercent(i.promo_valor) + ' de desconto' : 'por ' + formatBRL(i.promo_valor) %>
                    · <%= i.promo_inicio ? 'de ' + brDate(i.promo_inicio) + ' ' : '' %>até <%= brDate(i.promo_fim) %>
                  </span>
                  <form method="post" action="/admin/precos/<%= i.id %>/promo/remover" style="display:inline;margin:0 0 0 6px"><button class="btn ghost sm" type="submit">tirar</button></form>
                </div>
              <% } %>
              <form method="post" action="/admin/precos/<%= i.id %>/promo" class="promo-form">
                <select name="tipo">
                  <option value="percentual" <%= i.promo_tipo === 'percentual' ? 'selected' : '' %>>% de desconto</option>
                  <option value="valor" <%= i.promo_tipo === 'valor' ? 'selected' : '' %>>R$ (preço promocional)</option>
                </select>
                <input name="valor" placeholder="10" value="<%= i.promo_valor_txt %>" title="percentual de desconto ou preço promocional em R$" />
                <label>de <input type="date" name="inicio" value="<%= i.promo_inicio || '' %>" title="início (opcional, vazio = já)" /></label>
                <label>até <input type="date" name="fim" value="<%= i.promo_fim || '' %>" required /></label>
                <button class="btn ghost sm" type="submit"><%= i.promo_tipo ? 'Atualizar' : 'Aplicar' %></button>
              </form>
            </td>
            <td><form method="post" action="/admin/precos/<%= i.id %>/remove" style="margin:0"><button class="btn ghost sm" type="submit">Remover</button></form></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="hint-box" style="margin-top:12px">Promoção em <b>%</b> aplica o desconto sobre o preço negociado; em <b>R$</b> o valor informado passa a ser o preço do item. Vale do início (ou de agora, se vazio) até a data final, inclusive. O cliente vê o preço promocional ao subir a etiqueta e o pedido grava o valor cobrado na hora do aceite.</div>
    <% } %>
  </div>
</div>
<% } else { %>
  <div class="card pad"><div class="empty">Cadastre um cliente ativo para definir preços.</div></div>
<% } %>

<%- include('../partials/app-close') %>
