<%- include('../partials/app-open', { titulo: 'Pedido ' + pedido.numero, ativo: 'pedidos' }) %>

<h2 class="title">Pedido <%= pedido.numero %></h2>
<p class="sub">Cliente: <%= pedido.cliente_nome %><%= pedido.cliente_email ? ' · ' + pedido.cliente_email : '' %> · aceito em <%= formatDateTime(pedido.aceite_em) %></p>

<div class="card pad" style="margin-bottom:16px">
  <%- include('../partials/timeline', { passos: passos }) %>
</div>

<div class="card pad" style="margin-bottom:16px">
  <table>
    <thead><tr><th>Arquivo</th><th>Produto</th><th class="num">Qtd</th><th class="num">Unit.</th><th class="num">Total</th></tr></thead>
    <tbody>
      <% linhas.forEach(function (l) { %>
        <tr><td><%= l.arquivo_nome %></td><td><%= l.item_nome %></td><td class="num"><%= l.quantidade %></td><td class="num"><%= formatBRL(l.preco_centavos) %></td><td class="num"><%= formatBRL(l.total_centavos) %></td></tr>
      <% }); %>
    </tbody>
  </table>
  <div class="totalbar"><div class="muted"><b style="color:var(--text)"><%= pedido.total_etiquetas %> etiquetas</b></div><div class="big"><%= formatBRL(pedido.total_centavos) %></div></div>
  <div class="actions-inline" style="margin-top:14px">
    <% if (expirado) { %>
      <span class="doc-link off">Etiquetas expiradas</span>
    <% } else { %>
      <a class="doc-link" href="/admin/pedido/<%= pedido.id %>/etiquetas">Etiquetas (térmico) <span class="badge <%= horas < 6 ? 'danger' : 'warn' %>" style="padding:1px 6px"><%= Math.max(0, Math.floor(horas)) %>h</span></a>
    <% } %>
    <a class="doc-link" href="/admin/pedido/<%= pedido.id %>/comprovante">Relatório / comprovante</a>
  </div>
</div>

<div class="grid2">
  <!-- comissão do representante -->
  <div class="comm-box">
    <div class="section-title">Representante e comissão</div>
    <form method="post" action="/admin/pedido/<%= pedido.id %>/comissao">
      <div class="field"><label>Representante deste pedido</label>
        <select name="representante_id">
          <option value="">— sem representante —</option>
          <% reps.forEach(function (r) { %>
            <option value="<%= r.id %>" <%= pedido.representante_id === r.id ? 'selected' : '' %>><%= r.nome %> (padrão <%= formatPercent(r.comissao_bps) %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="row-3">
        <div class="field" style="margin:0"><label>Base</label><input value="<%= formatBRL(pedido.total_centavos) %>" disabled /></div>
        <div class="field" style="margin:0"><label>Comissão %</label><input name="percent" placeholder="ex.: 5" value="<%= pedido.comissao_bps ? (pedido.comissao_bps/100) : '' %>" /></div>
        <div class="field" style="margin:0"><label>Comissão (R$)</label><input value="<%= pedido.comissao_centavos ? formatBRL(pedido.comissao_centavos) : 'R$ 0,00' %>" disabled /></div>
      </div>
      <button class="btn" type="submit" style="margin-top:6px">Salvar comissão</button>
    </form>
    <div class="hint-box" style="margin-top:14px">Deixe a % em branco para usar a comissão padrão do representante. A comissão é base × %.</div>
  </div>

  <!-- funcionário + andamento -->
  <div class="comm-box">
    <div class="section-title">Funcionário (taxa por etiqueta)</div>
    <table>
      <tbody>
        <tr><td>Etiquetas</td><td class="num"><%= pedido.total_etiquetas %></td></tr>
        <% if (funcRef) { %>
          <tr><td>Taxa por etiqueta (<%= funcRef.nome %>)</td><td class="num"><%= formatBRL(funcRef.taxa_etiqueta_centavos) %></td></tr>
          <tr><td><b>Taxa do funcionário</b></td><td class="num"><b><%= formatBRL(taxaFuncCentavos) %></b></td></tr>
        <% } else { %>
          <tr><td colspan="2" class="dim" style="font-size:12px">O valor de cada funcionário aparece na área dele (etiquetas × taxa). Aqui só aparece quando há um único funcionário ativo.</td></tr>
        <% } %>
      </tbody>
    </table>

    <div class="section-title" style="margin-top:18px">Andamento</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <% if (pedido.status === 'aguardando') { %>
        <form method="post" action="/admin/pedido/<%= pedido.id %>/status" style="margin:0"><input type="hidden" name="acao" value="preparar" /><button class="btn ghost" type="submit">Iniciar preparação</button></form>
        <form method="post" action="/admin/pedido/<%= pedido.id %>/status" style="margin:0"><input type="hidden" name="acao" value="despachar" /><button class="btn" type="submit">Marcar despachado</button></form>
      <% } else if (pedido.status === 'preparando') { %>
        <form method="post" action="/admin/pedido/<%= pedido.id %>/status" style="margin:0"><input type="hidden" name="acao" value="despachar" /><button class="btn" type="submit">Marcar despachado</button></form>
      <% } else { %>
        <span class="badge ok" style="align-self:center">Despachado <%= formatDateTime(pedido.despachado_em) %></span>
        <form method="post" action="/admin/pedido/<%= pedido.id %>/status" style="margin:0"><input type="hidden" name="acao" value="reabrir" /><button class="btn ghost" type="submit">Reabrir</button></form>
      <% } %>
    </div>
  </div>
</div>

<div style="margin-top:18px"><a class="btn ghost" href="/admin/pedidos">Voltar aos pedidos</a></div>

<%- include('../partials/app-close') %>
