<%- include('../partials/app-open', { titulo: 'Pedidos recebidos', ativo: 'pedidos' }) %>

<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
  <h2 class="title" style="margin:0">Pedidos recebidos</h2>
  <% if (isFull) { %><a class="btn sm" href="/admin/retirada/nova">📦 Nova retirada no CD</a><% } %>
</div>
<p class="sub">Você (admin) vê tudo: valor, comissão do representante, taxa do funcionário e o <b>seu lucro</b> em cada pedido. Clique num pedido para abrir o detalhe e atribuir a comissão. Pedidos <b>RT-</b> são retiradas no CD.</p>

<% if (ok) { %><div class="alert ok"><%= ok %></div><% } %>

<div class="card pad">
  <% if (pedidos.length === 0) { %>
    <div class="empty">Nenhum pedido recebido ainda.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Pedido</th><th>Data</th><th>Cliente</th><th class="num">Etiq.</th><th class="num">Valor</th>
          <% if (isFull) { %><th>Representante</th><th class="num">Comissão</th><th class="num">Taxa func.</th><th class="num">Lucro</th><% } %><th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach(function (p) { %>
          <tr>
            <td><a class="link-row" href="/admin/pedido/<%= p.id %>"><b><%= p.numero %></b></a></td>
            <td style="white-space:nowrap"><% if (p.aceite_em) { var _dt = formatDateTime(p.aceite_em); %><%= _dt.slice(0, 10) %><div class="dim" style="font-size:11.5px"><%= _dt.slice(12) %></div><% } else { %><span class="dim">—</span><% } %></td>
            <td><%= p.cliente_nome %></td>
            <td class="num"><%= p.total_etiquetas %></td>
            <td class="num"><%= formatBRL(p.total_centavos) %></td>
            <% if (isFull) { %>
            <td><%= p.rep_nome ? p.rep_nome : '—' %></td>
            <td class="num"><% if (p.comissao_centavos) { %><span class="badge gold"><%= formatBRL(p.comissao_centavos) %></span><% } else { %><span class="dim">—</span><% } %></td>
            <td class="num"><% if (p.taxa_func_centavos !== null) { %><span class="badge gold"><%= formatBRL(p.taxa_func_centavos) %></span><% } else { %><span class="dim">—</span><% } %></td>
            <td class="num" style="white-space:nowrap"><b style="color:<%= p.lucro_centavos >= 0 ? 'var(--ok)' : 'var(--danger)' %>"><%= formatBRL(p.lucro_centavos) %></b><div class="dim" style="font-size:11px"><%= p.margem_pct.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %>%</div></td>
            <% } %>
            <td>
              <% if (p.tipo === 'retirada') { %>
                <span class="badge info">📦 Retirada</span>
                <% if (p.status === 'retirado') { %><span class="badge ok" style="margin-left:4px">Retirado</span>
                <% } else { %><span class="badge warn" style="margin-left:4px">Aguardando retirada</span><% } %>
              <% } else if (p.status === 'despachado') { %><span class="badge ok">Despachado</span>
              <% } else if (p.status === 'preparando') { %><span class="badge info">Em preparação</span>
              <% } else { %><span class="badge warn">Aguardando</span><% } %>
              <% if (p.com_nf) { %>
                <% if (p.tem_nf) { %><a href="/admin/pedido/<%= p.id %>" class="badge ok" style="margin-left:4px;text-decoration:none">🧾 NF ✓</a>
                <% } else { %><a href="/admin/pedido/<%= p.id %>" class="badge gold" style="margin-left:4px;text-decoration:none">🧾 anexar NF</a><% } %>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="hint-box">
  <% if (!isFull) { %>Sua conta é operacional: comissões e taxas ficam ocultas. <% } %>A coluna "Taxa func." aparece quando há um único funcionário ativo cadastrado
  <% if (!funcRef) { %>(no momento ela fica como — porque há zero ou mais de um funcionário; o valor de cada funcionário aparece na área dele).<% } %>
  Clique no número do pedido para atribuir o representante e a comissão, avançar o andamento e baixar os documentos.
  <% if (isFull) { %><br>A coluna <b>Lucro</b> (valor − custo − comissão − taxa) só aparece para você. O custo de cada pedido fica <b>congelado no aceite</b>: reajustar o custo depois não muda o lucro dos pedidos antigos.<% } %>
</div>

<%- include('../partials/app-close') %>
