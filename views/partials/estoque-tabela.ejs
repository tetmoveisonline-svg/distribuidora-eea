<% if (produtos.length === 0) { %>
  <div class="empty">Você ainda não tem produtos negociados.</div>
<% } else { %>
<table>
  <thead><tr><th>Produto</th><th>Cor</th><th>SKU</th><th class="num">Saldo</th></tr></thead>
  <tbody>
    <% produtos.forEach(function (p) { %>
      <% if (p.cores.length === 0) { %>
        <tr><td><%= p.nome %></td><td class="dim">cor única</td><td class="dim">—</td><td class="num"><span class="saldo-tag <%= p.saldo <= 0 ? 'zero' : (p.saldo <= 5 ? 'baixo' : '') %>"><%= p.saldo %></span></td></tr>
      <% } else { p.cores.forEach(function (c, i) { %>
        <tr><td><%= i === 0 ? p.nome : '' %></td><td><%= c.nome %></td><td class="mono dim"><%= c.sku || '—' %></td><td class="num"><span class="saldo-tag <%= c.saldo <= 0 ? 'zero' : (c.saldo <= 5 ? 'baixo' : '') %>"><%= c.saldo %></span></td></tr>
      <% }); } %>
    <% }); %>
  </tbody>
</table>
<% } %>
