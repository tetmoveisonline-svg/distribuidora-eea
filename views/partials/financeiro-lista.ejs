<%
  // Parametros: lancamentos, admin (true mostra cliente e acoes), formatBRL, formas (admin), hoje (admin)
  function badgeSit(l) {
    if (l.situacao === 'pago') return '<span class="badge ok">Pago ' + (l.pago_em_br || '') + '</span>';
    if (l.situacao === 'vencido') return '<span class="badge danger">Vencido · ' + l.dias_atraso + 'd</span>';
    if (l.situacao === 'cancelado') return '<span class="badge neutral">Cancelado</span>';
    return '<span class="badge warn">Em aberto</span>';
  }
%>
<% if (lancamentos.length === 0) { %>
  <div class="empty">Nenhum lançamento para esse filtro.</div>
<% } else { %>
<div style="overflow-x:auto">
<table class="fin-table">
  <thead>
    <tr>
      <th>Pedido</th>
      <% if (admin) { %><th>Cliente</th><% } %>
      <th>Itens</th>
      <th>Vencimento</th>
      <th class="num">Valor</th>
      <th>Situação</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% lancamentos.forEach(function (l) { %>
      <tr class="fin-row" data-fin="<%= l.id %>">
        <td><b><%= l.numero %></b></td>
        <% if (admin) { %><td><%= l.cliente_nome %></td><% } %>
        <td class="dim"><%= l.itens_resumo %> · <%= l.total_etiquetas %> etiq.</td>
        <td class="<%= l.situacao === 'vencido' ? 'fin-venc' : '' %>"><%= l.vencimento_br %></td>
        <td class="num">
          <%= formatBRL(l.valor_centavos) %>
          <% if (l.ajustado) { %><div class="dim" style="font-size:11px;text-decoration:line-through"><%= formatBRL(l.valor_original) %></div><% } %>
        </td>
        <td><%- badgeSit(l) %><% if (l.nao_enviadas > 0) { %> <span class="badge neutral" title="etiquetas que ficaram de fora no encerramento"><%= l.nao_enviadas %> não enviada(s)</span><% } %></td>
        <td class="num" style="white-space:nowrap"><% if (!admin && l.pix) { %><button type="button" class="btn sm pix-toggle" data-pix="<%= l.id %>" style="margin-right:6px">Pagamento do Pedido</button><% } %><button type="button" class="btn ghost sm fin-toggle" data-fin="<%= l.id %>">detalhe</button></td>
      </tr>
      <% if (!admin && l.pix) { %>
      <tr class="pix-row" id="pix-<%= l.id %>" style="display:none">
        <td colspan="6">
          <div class="fin-detail-box pix-box">
            <div class="pix-qr"><%- l.pix.qr %></div>
            <div class="pix-info">
              <div class="pix-tit">Pague o pedido <%= l.numero %> com Pix</div>
              <div class="dim pix-sub">Abra o app do banco, escolha Pix &gt; Ler QR Code. O valor já vem preenchido.</div>
              <div class="pix-grid">
                <span class="dim">Valor</span><b class="pix-valor"><%= formatBRL(l.valor_centavos) %></b><span></span>
                <span class="dim">Chave CPF</span><span class="mono"><%= l.pix.chave %></span><button type="button" class="btn ghost sm pix-copy" data-copy="<%= l.pix.chaveCopia %>">Copiar chave</button>
                <span class="dim">Copia e cola</span><span class="mono pix-cod"><%= l.pix.codigo %></span><button type="button" class="btn ghost sm pix-copy" data-copy="<%= l.pix.codigo %>">Copiar código</button>
                <span class="dim">Favorecido</span><span><%= l.pix.favorecido %></span><span></span>
              </div>
              <div class="pix-acoes">
                <a class="btn sm" href="<%= l.pix.whatsapp %>" target="_blank" rel="noopener">Já paguei, avisar no WhatsApp</a>
                <span class="dim">Abre o WhatsApp do Gabriel com a mensagem pronta. Anexe o comprovante.</span>
              </div>
            </div>
          </div>
        </td>
      </tr>
      <% } %>
      <tr class="fin-detail" id="fin-detail-<%= l.id %>" style="display:none">
        <td colspan="<%= admin ? 7 : 6 %>">
          <div class="fin-detail-box">
            <table class="fin-itens">
              <thead><tr><th>Item (preço negociado)</th><th class="num">Qtd</th><th class="num">Unit.</th><th class="num">Total</th></tr></thead>
              <tbody>
                <% l.linhas.forEach(function (x) { %>
                  <tr><td><%= x.item_nome %></td><td class="num"><%= x.quantidade %></td><td class="num"><%= formatBRL(x.preco_centavos) %></td><td class="num"><%= formatBRL(x.total_centavos) %></td></tr>
                <% }); %>
              </tbody>
            </table>
            <% if (l.ajustado) { %>
              <table class="fin-itens fin-comp">
                <tbody>
                  <tr><td>Reservado no aceite · <%= l.etiquetas_total || '—' %> etiqueta(s)</td><td class="num dim"><%= formatBRL(l.valor_original) %></td></tr>
                  <% if (l.credito_gerado > 0) { %>
                    <tr><td>Despachadas · <%= l.etiquetas_cobradas %> etiqueta(s)</td><td class="num"><%= formatBRL(l.valor_cobrado) %></td></tr>
                    <tr class="fin-cred"><td>Não enviadas · <%= l.nao_enviadas %> etiqueta(s) → crédito<%= l.status === 'pago' && l.encerrado_em_br ? ' em conta' : ' (limite liberado)' %><%= l.encerrado_em_br ? ' · encerrado em ' + l.encerrado_em_br : '' %></td><td class="num">− <%= formatBRL(l.credito_gerado) %></td></tr>
                  <% } %>
                  <% if (l.credito_usado > 0) { %>
                    <tr class="fin-cred"><td>Crédito em conta usado neste pedido</td><td class="num">− <%= formatBRL(l.credito_usado) %></td></tr>
                  <% } %>
                  <tr class="fin-tot"><td>Valor a pagar</td><td class="num"><%= formatBRL(l.valor_centavos) %></td></tr>
                </tbody>
              </table>
            <% } %>
            <div class="fin-meta">
              <% if (l.situacao === 'pago') { %>
                <span>Pago em <b><%= l.pago_em_br %></b><% if (l.forma_pagamento) { %> via <b><%= l.forma_pagamento %></b><% } %><% if (l.observacao) { %> · <%= l.observacao %><% } %></span>
              <% } else if (l.observacao) { %>
                <span><%= l.observacao %></span>
              <% } %>
              <a class="doc-link" href="<%= admin ? '/admin/pedido/' + l.pedido_id + '/comprovante' : '/pedido/' + l.pedido_id + '/comprovante' %>">Comprovante do pedido</a>
              <% if (admin) { %><a class="doc-link" href="/admin/pedido/<%= l.pedido_id %>">Abrir pedido</a><% } %>
            </div>
            <% if (admin) { %>
              <% if (l.situacao === 'pago') { %>
                <form method="post" action="/admin/financeiro/<%= l.id %>/reabrir" class="fin-form">
                  <input type="hidden" name="ret_cliente" value="<%= filtro.cliente || '' %>" /><input type="hidden" name="ret_situacao" value="<%= filtro.situacao %>" /><input type="hidden" name="ret_mes" value="<%= filtro.mes %>" />
                  <button class="btn ghost sm" type="submit">Desfazer pagamento</button>
                </form>
              <% } else if (l.situacao !== 'cancelado') { %>
                <form method="post" action="/admin/financeiro/<%= l.id %>/pagar" class="fin-form">
                  <input type="hidden" name="ret_cliente" value="<%= filtro.cliente || '' %>" /><input type="hidden" name="ret_situacao" value="<%= filtro.situacao %>" /><input type="hidden" name="ret_mes" value="<%= filtro.mes %>" />
                  <div class="field" style="margin:0"><label>Data do pagamento</label><input type="date" name="pago_em" value="<%= hoje %>" required /></div>
                  <div class="field" style="margin:0"><label>Forma</label>
                    <select name="forma"><% formas.forEach(function (f) { %><option><%= f %></option><% }); %></select></div>
                  <div class="field" style="margin:0;flex:1;min-width:160px"><label>Observação</label><input name="observacao" placeholder="opcional" maxlength="200" /></div>
                  <button class="btn sm" type="submit">Marcar pago</button>
                </form>
              <% } %>
            <% } %>
          </div>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>
<% if (!admin) { %>
<style>
  .pix-row td, .pix-box { white-space:normal; }
  .pix-box { display:flex; gap:22px; align-items:center; flex-wrap:wrap; }
  .pix-qr svg { width:170px; height:170px; display:block; border-radius:10px; }
  .pix-info { flex:1; min-width:260px; }
  .pix-tit { font-weight:650; font-size:15px; margin-bottom:4px; }
  .pix-sub { font-size:12.5px; margin-bottom:12px; }
  .pix-grid { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:8px 14px; align-items:center; font-size:13px; }
  .pix-valor { font-size:16px; }
  .pix-cod { font-size:11px; color:var(--text-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pix-acoes { margin-top:14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; font-size:12px; }
  @media (max-width:640px) {
    .pix-box { gap:14px; }
    .pix-qr { margin:0 auto; }
    .pix-grid { grid-template-columns:auto minmax(0,1fr); }
    .pix-grid > span:empty { display:none; }
    .pix-grid .pix-copy { grid-column:1 / -1; justify-self:start; }
  }
</style>
<script>
(function () {
  document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('.pix-toggle') : null;
    if (b) {
      var r = document.getElementById('pix-' + b.getAttribute('data-pix'));
      if (!r) return;
      var abrir = r.style.display === 'none';
      r.style.display = abrir ? 'table-row' : 'none';
      if (abrir) {
        // no celular a tabela rola de lado: o quadro fica preso a esquerda e do tamanho da area visivel
        var box = r.querySelector('.pix-box');
        var sc = [r.closest('table'), r.closest('div[style*="overflow-x"]')].filter(function (el) { return el && el.scrollWidth > el.clientWidth; })[0];
        if (sc && box) { sc.scrollLeft = 0; box.style.position = 'sticky'; box.style.left = '0'; box.style.maxWidth = (sc.clientWidth - 24) + 'px'; }
      }
      return;
    }
    var c = e.target.closest ? e.target.closest('.pix-copy') : null;
    if (!c) return;
    var txt = c.getAttribute('data-copy'), rot = c.textContent;
    function ok() { c.textContent = 'Copiado ✓'; setTimeout(function () { c.textContent = rot; }, 1600); }
    if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(txt).then(ok, fallback); } else { fallback(); }
    function fallback() {
      var t = document.createElement('textarea'); t.value = txt; t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.appendChild(t); t.select(); try { document.execCommand('copy'); ok(); } catch (x) {} t.remove();
    }
  });
})();
</script>
<% } %>
<% } %>
