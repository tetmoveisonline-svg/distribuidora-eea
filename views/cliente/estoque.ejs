<%- include('../partials/app-open', { titulo: 'Estoque', ativo: 'estoque' }) %>

<h2 class="title">Estoque</h2>
<p class="sub">Saldo atual dos produtos que você tem negociação. Atualiza sozinho a cada 30 segundos; cada etiqueta despachada baixa 1 unidade.</p>

<div class="card pad">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
    <div class="section-title" style="margin:0">Produtos negociados</div>
    <span class="dim" style="font-size:12px">Atualizado às <span id="estAtual"><%= formatDateTime(new Date()).slice(11) %></span> · <button type="button" class="btn ghost sm" id="estRefresh">Atualizar agora</button></span>
  </div>
  <div id="estBox">
    <%- include('../partials/estoque-tabela', { produtos: produtos }) %>
  </div>
</div>

<div class="hint-box">Saldo em <span style="color:var(--danger)">vermelho</span> está esgotado; em <span style="color:var(--warn)">amarelo</span> está baixo (5 ou menos). Ao subir etiquetas, o sistema avisa se a quantidade passa do saldo, mas o pedido segue; a distribuidora confirma a reposição.</div>

<script>
(function () {
  var box = document.getElementById('estBox');
  var at = document.getElementById('estAtual');
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]; }); }
  function tag(n) { var cls = n <= 0 ? ' zero' : (n <= 5 ? ' baixo' : ''); return '<span class="saldo-tag' + cls + '">' + n + '</span>'; }
  function render(produtos) {
    if (!produtos.length) { box.innerHTML = '<div class="empty">Você ainda não tem produtos negociados.</div>'; return; }
    var h = '<table><thead><tr><th>Produto</th><th>Cor</th><th>SKU</th><th class="num">Saldo</th></tr></thead><tbody>';
    produtos.forEach(function (p) {
      if (!p.cores.length) {
        h += '<tr><td>' + esc(p.nome) + '</td><td class="dim">cor única</td><td class="dim">—</td><td class="num">' + tag(p.saldo) + '</td></tr>';
      } else {
        p.cores.forEach(function (c, i) {
          h += '<tr><td>' + (i === 0 ? esc(p.nome) : '') + '</td><td>' + esc(c.nome) + '</td><td class="mono dim">' + esc(c.sku || '—') + '</td><td class="num">' + tag(c.saldo) + '</td></tr>';
        });
      }
    });
    box.innerHTML = h + '</tbody></table>';
  }
  function atualizar() {
    fetch('/api/estoque').then(function (r) { return r.json(); }).then(function (d) {
      if (!d.ok) return;
      render(d.produtos);
      at.textContent = String(d.atualizado_em).slice(11);
    }).catch(function () {});
  }
  document.getElementById('estRefresh').addEventListener('click', atualizar);
  setInterval(atualizar, 30000);
})();
</script>

<%- include('../partials/app-close') %>
